# ---- Supabase（MEO と同じプロジェクト）----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- このアプリの公開URL（OAuth のリダイレクト先・データ削除の確認ページに使う）----
NEXT_PUBLIC_SITE_URL=https://sns.example.jp

# ---- Meta（Facebook ログイン：Facebookページ＋Instagram）。MEO とは別のアプリを推奨 ----
META_APP_ID=
META_APP_SECRET=

# ---- Threads ----
THREADS_APP_ID=
THREADS_APP_SECRET=
# 競合の Threads のフォロワー数を取る場合（threads_profile_discovery がアプリレビューで承認済みなら 1）
THREADS_PROFILE_DISCOVERY=

# ---- AI 分析（任意）----
ANTHROPIC_API_KEY=

# ---- 定期実行の認証（Vercel Cron / Supabase pg_cron から付ける Bearer）----
CRON_SECRET=
